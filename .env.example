# ==============================================================================
# DataForge .pathway x rime - Environment Configuration
# ==============================================================================

# Supabase Database (PostgreSQL via Prisma)
# Create a project at https://supabase.com, then copy these from Settings > API
# Connection string format: postgres://postgres.[ref]:password@aws-0-[region].pooler.supabase.com:6543/...
DATABASE_URL="postgres://postgres:password@localhost:5432/postgres"

# Supabase Project Settings
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Supabase Storage bucket for uploaded PDFs
SUPABASE_STORAGE_BUCKET="pdf-documents"

# JWT Authentication (Supabase Auth uses these automatically)
# Generate a strong secret: https://supabase.com/guides/auth/auth-jwt-signing-secret
JWT_SECRET="replace_with_a_secure_jwt_secret_key"

# Rime AI Voice Synthesis (Required)
# Model options: "arcana" (recommended with speaker "astra") or "mist" (with "marsh")
RIME_API_KEY="your_rime_api_key_here"
RIME_MODEL="arcana"
RIME_SPEAKER="astra"

# LLM Grounding & Extraction
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here_optional"